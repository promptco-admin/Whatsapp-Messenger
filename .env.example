# WhatsApp Cloud API credentials (from Meta Business / developers.facebook.com)
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_API_VERSION=v21.0

# Webhook verification token — any random string, must match what you set in Meta App Dashboard
WHATSAPP_WEBHOOK_VERIFY_TOKEN=pick-a-random-string

# Meta App Secret — used to verify webhook payload signatures
WHATSAPP_APP_SECRET=your_app_secret_here

# SQLite database file path (absolute or relative to project root)
DATABASE_PATH=./data/messenger.db

# Prompt-Solar CRM integration — server-to-server calls in both directions.
# CRM_SERVICE_KEY: long random string, shared with Prompt-Solar CRM's edge
#   functions (WA_MESSENGER_SERVICE_KEY there). Authenticates POSTs to
#   /api/external/send and /api/external/upload.
# PROMPT_CRM_SUPABASE_URL: base URL of the CRM's Supabase project (used to
#   build the wa-approval-callback function URL).
# PROMPT_CRM_CALLBACK_KEY: a separate long random string (NOT the CRM's
#   Supabase service_role key — deliberately narrow-scoped) shared with that
#   one edge function. Authenticates the webhook's relay when a customer taps
#   Approve/Disapprove on the finalize-approval WhatsApp message.
CRM_SERVICE_KEY=pick-a-long-random-string
PROMPT_CRM_SUPABASE_URL=https://your-crm-project.supabase.co
PROMPT_CRM_CALLBACK_KEY=pick-a-different-long-random-string
